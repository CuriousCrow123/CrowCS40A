---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BitOperator from '../../components/widgets/BitOperator.svelte';
---

<BaseLayout title="Sandbox: Bit Operator">
  <main style="padding: var(--space-2xl); max-width: var(--figure-width); margin-inline: auto;">
    <a href="/sandbox" style="color: var(--color-accent);">&larr; All widgets</a>
    <h1 style="margin-block: var(--space-lg); font-size: 1.75rem;">Bit Operator</h1>
    <p style="color: var(--color-text-muted); margin-bottom: var(--space-xl);">
      Bitwise operation visualizer with per-bit animation.
    </p>
    <div style="background: var(--color-bg-raised); padding: var(--space-xl); border-radius: var(--radius-lg); border: 1px solid var(--color-border);">
      <BitOperator client:load instanceId="sandbox-bitop" valueA={0b1010} valueB={0b1100} operation="NOR" />
    </div>
  </main>
</BaseLayout>
