---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ShiftVisualizer from '../../components/widgets/ShiftVisualizer.svelte';
---

<BaseLayout title="Sandbox: Shift Visualizer">
  <main style="padding: var(--space-2xl); max-width: var(--figure-width); margin-inline: auto;">
    <a href="/sandbox" style="color: var(--color-accent);">&larr; All widgets</a>
    <h1 style="margin-block: var(--space-lg); font-size: 1.75rem;">Shift Visualizer</h1>
    <p style="color: var(--color-text-muted); margin-bottom: var(--space-xl);">
      Bit shift animation showing binary shift operations with decimal equivalents.
    </p>
    <div style="background: var(--color-bg-raised); padding: var(--space-xl); border-radius: var(--radius-lg); border: 1px solid var(--color-border);">
      <ShiftVisualizer client:load instanceId="sandbox-shift" value={5} shiftAmount={2} direction="left" />
    </div>
  </main>
</BaseLayout>
